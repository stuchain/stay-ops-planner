{
  "name": "@stay-ops/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=6144 next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:e2e": "playwright test",
    "e2e:calendar": "playwright test calendar-journeys --project=desktop-chromium",
    "e2e:lighthouse": "cross-env LIGHTHOUSE=1 playwright test calendar-lighthouse --project=desktop-chromium",
    "test:e2e:smoke": "playwright test --grep \"@smoke\"",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:visual": "cross-env PLAYWRIGHT_VISUAL=1 playwright test tests/e2e/visual --project=visual-desktop"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/commissioner": "^5.3.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.2.0",
    "@sentry/nextjs": "9",
    "@stay-ops/audit": "workspace:*",
    "@stay-ops/db": "workspace:*",
    "@stay-ops/domain": "workspace:*",
    "@stay-ops/shared": "workspace:*",
    "@stay-ops/sync": "workspace:*",
    "@tanstack/query-sync-storage-persister": "5.104.1",
    "@tanstack/react-query": "^5",
    "@tanstack/react-query-persist-client": "5.104.1",
    "@trpc/client": "^11",
    "@trpc/server": "^11",
    "@trpc/tanstack-react-query": "^11",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "^15.1.6",
    "next-intl": "^4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^12.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "axe-core": "^4.14.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.6",
    "eslint-import-resolver-typescript": "^3",
    "eslint-plugin-boundaries": "^5",
    "eslint-plugin-i18next": "^6",
    "jsdom": "^26.0.0",
    "lighthouse": "12",
    "postcss": "^8.5.29",
    "tailwindcss": "^4",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
