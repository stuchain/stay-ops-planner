{
  "name": "stay-ops-planner",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @stay-ops/shared build && corepack pnpm --filter @stay-ops/db build && corepack pnpm --filter @stay-ops/audit build && corepack pnpm --filter @stay-ops/sync build && corepack pnpm --filter @stay-ops/web dev",
    "build": "turbo run build",
    "build:web": "corepack pnpm --filter=@stay-ops/web... --reporter=append-only run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "node ./scripts/test-integration.mjs",
    "hosthub:smoke": "node ./scripts/hosthub-smoke.mjs",
    "hosthub:count-bookings": "node ./scripts/hosthub-count-bookings.mjs",
    "hosthub:db-overlap-year": "node ./packages/db/scripts/db-overlap-year-snapshot.mjs",
    "perf:calendar-baseline": "node ./packages/db/scripts/explain-calendar-baseline.mjs",
    "hosthub:reconcile-full": "corepack pnpm --filter @stay-ops/web run hosthub:reconcile-full",
    "e2e:local": "node ./scripts/e2e-local.mjs",
    "backup:pg": "node ./scripts/backup-postgres.mjs",
    "backup:prune": "node ./scripts/backup-prune.mjs",
    "backup:verify-restore": "node ./scripts/restore-verify-postgres.mjs",
    "retention:prune": "corepack pnpm --filter @stay-ops/db run retention:prune",
    "smoke:epic7-auth": "corepack pnpm --filter @stay-ops/db run smoke:epic7-auth",
    "db:migrate-docker-to-neon": "node ./scripts/migrate-docker-to-neon.mjs",
    "db:create-user": "node ./scripts/db-create-user.mjs",
    "format": "prettier --write packages/domain/src apps/web/src/ui apps/web/src/api apps/web/src/server apps/web/tests/unit/api",
    "format:check": "prettier --check packages/domain/src apps/web/src/ui apps/web/src/api apps/web/src/server apps/web/tests/unit/api"
  },
  "devDependencies": {
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "5.7.2"
  }
}
